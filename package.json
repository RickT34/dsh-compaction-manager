{
  "name": "dsh-compaction-manager",
  "version": "0.4.0",
  "type": "module",
  "description": "Unified compaction panel for DeepSeek Harness: order model-free compaction methods (official pruner, Magic Compact, OpenCode DCP, tool-call folding), tune compaction-basic, preview results, and restore hidden content.",
  "license": "MIT",
  "author": "RickT34",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RickT34/dsh-compaction-manager.git"
  },
  "homepage": "https://github.com/RickT34/dsh-compaction-manager#readme",
  "bugs": {
    "url": "https://github.com/RickT34/dsh-compaction-manager/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "context",
    "compaction",
    "cordis"
  ],
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./core": "./src/core.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src/",
    "dist/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icon-180.png",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-compaction-basic": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction-tool-result-pruner": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "link-dsh": "node scripts/link-dsh.mjs",
    "test": "node --test test/*.test.mjs"
  }
}
